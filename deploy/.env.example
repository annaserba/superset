# Copy to deploy/.env and adjust.  deploy/.env is git-ignored.
#
#   cp deploy/.env.example deploy/.env
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"   # new secret

# --- Superset ---
# REQUIRED.  Signs session cookies and encrypts stored DB passwords.
# Never commit the real value; never reuse a placeholder.
SUPERSET_SECRET_KEY=change-me-generate-with-secrets-token_urlsafe

# Image tag of apache/superset the local image is built FROM.
SUPERSET_VERSION=6.1.0

# Host port for the UI.
SUPERSET_PORT=8088

# Password for the `admin` user.  docker-init.sh only applies it when it
# creates the user, so changing it later does not change an existing password
# (use `docker compose exec superset superset fab reset-password`).
ADMIN_PASSWORD=admin

# Load the bundled example dashboards into the data database (slow on the first
# start).  Needed once if you want the `sales` / `employees` example tables that
# the shipped charts query.
SUPERSET_LOAD_EXAMPLES=false

# Set to true only when Superset is served over HTTPS.
SUPERSET_COOKIE_SECURE=false

# UI language: en | ru
SUPERSET_DEFAULT_LOCALE=en

# --- Databases ---
# POSTGRES_DB holds the DATA (example tables, your own imports).
# Superset's own metadata lives in a separate database, superset_metadata,
# created by docker-entrypoint-initdb.d on the first start.
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset
POSTGRES_DB=superset
# 17 for a fresh volume.  Do not raise this on an existing volume without a
# pg_upgrade: Postgres refuses to start on a data directory from a newer major.
POSTGRES_VERSION=17
